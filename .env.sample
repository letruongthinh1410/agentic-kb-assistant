# OptiBot — Sample Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.

# ── Gemini API (required for main.py and upload_file_search.py) ───────────────
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# After the first successful run, paste the store resource name here.
# Example: GEMINI_STORE_NAME=fileSearchStores/optisignssupportdocs-xxxxxxxxxx
# This skips the list/create step on subsequent runs (faster and more reliable).
GEMINI_STORE_NAME=

# Gemini model to use for the assistant (optional, default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── Zendesk API (optional — leave blank for public/unauthenticated access) ────
# Only needed if you access a private / paid Zendesk plan.
ZENDESK_TOKEN=

# ── Pipeline runtime paths (optional — safe to leave at defaults) ─────────────
# Path to the state JSON file for delta detection (default: state.json)
# STATE_FILE=state.json
#
# Directory to write scraped Markdown files (default: docs)
# DOCS_DIR=docs

# ── OpenAI API (required only for upload_vector_store.py) ────────────────────
# Only needed if using the OpenAI-based uploader instead of Gemini.
# OPENAI_API_KEY=your-openai-api-key-here
